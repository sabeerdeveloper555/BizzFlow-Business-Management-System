# BizFlow frontend environment configuration
# Copy to .env.local for local development. Only VITE_* vars reach the browser.
# Do NOT put any secret values here — they are exposed in the built bundle.

# Backend API base URL.
# Local development default (falls back automatically if unset):
#   http://localhost:5000/api
# For a production build set this to your deployed backend, e.g.:
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api
