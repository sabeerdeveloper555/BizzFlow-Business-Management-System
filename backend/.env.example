# BizFlow backend environment configuration
# Copy to .env for local development. NEVER commit real secrets.

# Server port
PORT=5000

# MongoDB connection string (Atlas or local). Supply real credentials only in
# the deployment environment; do not commit them.
MONGODB_URI=your_mongodb_connection_string

# JWT signing secret. MUST be a long, random, high-entropy value in production.
# Generate one (e.g. `openssl rand -hex 64`) and provide it via the deployment
# environment. The development placeholder is NOT safe for production.
JWT_SECRET=replace_with_a_strong_random_secret
# Token lifetime (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Allowed CORS origin(s) for the frontend. Comma-separated list of exact origins.
# Leave UNSET for local development (permissive default). In production set this
# to your deployed frontend origin, e.g. https://app.example.com
CORS_ALLOWED_ORIGIN=
